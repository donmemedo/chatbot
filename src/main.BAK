def loaders():
    tokenizer = AutoTokenizer.from_pretrained(settings.MODEL)
    model = AutoModelForQuestionAnswering.from_pretrained(settings.MODEL)
    nlp = pipeline("question-answering", model, tokenizer)
    return tokenizer, model, nlp
